import ProofComplexity.Operation
import ProofComplexity.Tangent
import ProofComplexity.Standard
import ProofComplexity.Control

/-!
# Yardsticks, computed from the compiled proofs

For a theorem `c`:
* `own_lines`: source lines of its declaration;
* `term`: size of its proof term (distinct sub-terms), auxiliary lemmas it generated included;
* `direct`: distinct theorems its proof term cites (seeing through generated auxiliaries);
* `closure`: theorems in its full dependency closure, down to Lean's core;
* `depth`: the longest chain of theorems below it;
* `unshared`: theorems (and their source lines) in its closure that the other proof's
  closure does not need.
-/

open Lean Elab Command Meta

namespace Yard

def usedConsts (env : Environment) (n : Name) : Array Name :=
  match env.find? n with
  | some ci => match ci.value? (allowOpaque := true) with
    | some v => v.getUsedConstants ++ ci.type.getUsedConstants
    | none => ci.type.getUsedConstants
  | none => #[]

def isThm (env : Environment) (n : Name) : Bool :=
  match env.find? n with
  | some (.thmInfo _) => true
  | _ => false

/-- Direct theorem citations, seeing through internal auxiliaries (`_proof_`, `_simp_`, …). -/
partial def directThms (env : Environment) (root : Name) : NameSet := Id.run do
  let mut seen : NameSet := {}
  let mut out : NameSet := {}
  let mut stack := (usedConsts env root).toList
  while !stack.isEmpty do
    match stack with
    | [] => break
    | n :: rest =>
      stack := rest
      if seen.contains n then continue
      seen := seen.insert n
      if n.isInternal then
        stack := (usedConsts env n).toList ++ stack
      else if isThm env n then
        out := out.insert n
  return out

/-- Full closure: every theorem reachable through values and types of constants. -/
def closure (env : Environment) (root : Name) : NameSet := Id.run do
  let mut seen : NameSet := {}
  let mut stack := (usedConsts env root).toList
  while !stack.isEmpty do
    match stack with
    | [] => break
    | n :: rest =>
      stack := rest
      if seen.contains n then continue
      seen := seen.insert n
      stack := (usedConsts env n).toList ++ stack
  return seen.toList.foldl (init := {}) fun acc n => if isThm env n then acc.insert n else acc

/-- Longest chain of theorems below `root` (definitions are transparent, weight 0). -/
partial def depth (env : Environment) (root : Name) : Nat := Id.run do
  -- iterative post-order with memo
  let mut memo : Std.HashMap Name Nat := {}
  let mut stack : List (Name × Bool) := [(root, false)]
  while !stack.isEmpty do
    match stack with
    | [] => break
    | (n, expanded) :: rest =>
      stack := rest
      if memo.contains n then continue
      let deps := usedConsts env n
      if expanded then
        let m := deps.foldl (fun acc d => max acc (memo.getD d 0)) 0
        let w := if isThm env n && !n.isInternal && n != root then 1 else 0
        memo := memo.insert n (m + w)
      else
        stack := (n, true) :: stack
        for d in deps do
          if !memo.contains d then stack := (d, false) :: stack
  return memo.getD root 0

/-- Proof-term size: distinct sub-terms, auxiliaries generated by this proof inlined. -/
partial def termSize (env : Environment) (root : Name) : Nat := Id.run do
  let mut seenE : Std.HashSet Expr := {}
  let mut seenC : NameSet := {}
  let mut todoC : List Name := [root]
  let mut count := 0
  while !todoC.isEmpty do
    match todoC with
    | [] => break
    | c :: rest =>
      todoC := rest
      if seenC.contains c then continue
      seenC := seenC.insert c
      let some ci := env.find? c | continue
      let some v := ci.value? (allowOpaque := true) | continue
      let mut st : List Expr := [v]
      while !st.isEmpty do
        match st with
        | [] => break
        | e :: r =>
          st := r
          if seenE.contains e then continue
          seenE := seenE.insert e
          count := count + 1
          match e with
          | .app f a => st := f :: a :: st
          | .lam _ t b _ => st := t :: b :: st
          | .forallE _ t b _ => st := t :: b :: st
          | .letE _ t v b _ => st := t :: v :: b :: st
          | .mdata _ b => st := b :: st
          | .proj _ _ b => st := b :: st
          | .const n _ => if n.isInternal && n.getPrefix == c || (n.isInternal && root.isPrefixOf n) then todoC := n :: todoC
          | _ => pure ()
  return count

def declLines (n : Name) : MetaM Nat := do
  match ← findDeclarationRanges? n with
  | some r => return r.range.endPos.line - r.range.pos.line + 1
  | none => return 0

def sumLines (s : NameSet) : MetaM Nat :=
  s.toList.foldlM (init := 0) fun acc n => do return acc + (← declLines n)

def diff (a b : NameSet) : NameSet :=
  a.toList.foldl (init := ({} : NameSet)) fun acc n => if b.contains n then acc else acc.insert n

def row (label which : String) (c : Name) (cl : NameSet) (others : List (String × NameSet)) :
    MetaM String := do
  let env ← getEnv
  let dir := directThms env c
  let mut extra := ""
  for (o, oc) in others do
    let u := diff cl oc
    extra := extra ++ s!",\"unshared_vs_{o}\":{u.size},\"unshared_lines_vs_{o}\":{← sumLines u}"
  let hct := cl.toList.filter (fun n => (`HCT).isPrefixOf n)
  let hctLines ← hct.foldlM (init := 0) fun acc n => do return acc + (← declLines n)
  return s!"\{\"result\":\"{label}\",\"route\":\"{which}\",\"name\":\"{c}\",\"own_lines\":{← declLines c},\"term\":{termSize env c},\"direct\":{dir.size},\"closure\":{cl.size},\"depth\":{depth env c},\"framework_lemmas\":{(hct.map toString)},\"framework_lines\":{hctLines}{extra},\"direct_names\":{(dir.toList.map (fun n => s!"\"{n}\"")).toString}}".replace "framework_lemmas\":[" "framework_lemmas\":[\""
end Yard

elab "#yard" : command => liftTermElabM do
  let env ← getEnv
  let rows : List (String × Name × Name × Option Name) := [
    ("R1 subset expansion", ``Finset.prod_one_add, ``HCT.Results.op_prod_one_add,
      some ``HCT.Control.ctl_prod_one_add),
    ("R2 inclusion-exclusion", ``Finset.inclusion_exclusion_card_biUnion,
      ``HCT.Results.op_inclusion_exclusion_card_biUnion,
      some ``HCT.Control.ctl_inclusion_exclusion_card_biUnion),
    ("R3 Moebius heart", ``Finset.sum_powerset_neg_one_pow_card_of_nonempty,
      ``HCT.Results.op_sum_powerset_neg_one_pow_card_of_nonempty,
      some ``HCT.Control.ctl_sum_powerset_neg_one_pow_card_of_nonempty),
    ("R4 binomial", ``HCT.Results.std_one_add_pow, ``HCT.Results.op_one_add_pow,
      some ``HCT.Control.ctl_one_add_pow),
    ("R5 geometric series", ``geom_sum_mul, ``HCT.Results.op_geom_sum_mul,
      some ``HCT.Control.ctl_geom_sum_mul),
    ("R6 tangent addition", ``HCT.Results.std_tan_add, ``HCT.Results.op_tan_add, none)]
  let mut out := ""
  for (l, s, o, c?) in rows do
    let cs := Yard.closure env s
    let co := Yard.closure env o
    match c? with
    | some c =>
      let cc := Yard.closure env c
      out := out ++ (← Yard.row l "standard" s cs [("standard", cs), ("operation", co), ("control", cc)]) ++ "\n"
      out := out ++ (← Yard.row l "operation" o co [("standard", cs), ("operation", co), ("control", cc)]) ++ "\n"
      out := out ++ (← Yard.row l "control" c cc [("standard", cs), ("operation", co), ("control", cc)]) ++ "\n"
    | none =>
      out := out ++ (← Yard.row l "standard" s cs [("standard", cs), ("operation", co)]) ++ "\n"
      out := out ++ (← Yard.row l "operation" o co [("standard", cs), ("operation", co)]) ++ "\n"
  IO.FS.writeFile "yard.jsonl" out
  logInfo m!"done"

#yard
