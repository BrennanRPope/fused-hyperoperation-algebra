/-
  Fused Hyperoperation Algebra: the running of G beyond one loop
  (topics/why-i/e-i-pi/asymptotic-safety/beyond-one-loop).
  Core Lean 4 only (no mathlib), no `sorry`, no imports.

  Compiled Nov 25 with the library toolchain (v4.37.0-rc1), unchanged, as
  FusedAlgebra/Topics/BeyondOneLoop.lean: 9 theorems, standard axioms only.

  Only exact polynomial identities over Int live here (divisions are cleared by
  cross-multiplying). The flows themselves are checked numerically in ../checks.py.
  1. the plane law's flows are generated by 1 + k x + d x² and have opposite exponents
     at their two walls (check T1);
  2. the Litim λ = 0 flow: its partial fractions give exponents 1/2 and 11/23, which differ
     by 1/46 (checks P3, T3, T5);
  3. the large-N flow is two decoupled circle-op flows in u = 1/g, v = λ/g (check L1);
  4. Donà–Eichhorn–Percacci's perturbative flow in v = Λ/G has one extra term,
     (C − A)·G·Λ, and C − A = 30 (in units of 1/6π) for every matter content (check L6);
  5. the Gaussian point's stability matrix squares to 4: a pure boost (check L7).
-/
namespace BeyondOneLoop

/-! ## 1. Plane-law flows have opposite exponents at their two walls -/

/-- One step of the plane law, cross-multiplied: (x ∘ s)(1 − d x s) − x(1 − d x s) = s(1 + k x + d x²).
So the flow is generated by V(x) = 1 + k x + d x². -/
theorem plane_generator (k d x s : Int) :
    (x + s + k * x * s) - x * (1 - d * x * s) = s * (1 + k * x + d * x * x) := by grind

/-- With walls r₁, r₂ (so k = −d(r₁ + r₂)), V′(r₁) + V′(r₂) = 0: the exponents are ±. -/
theorem plane_exponents_opposite (d r₁ r₂ : Int) :
    ((-(d * (r₁ + r₂))) + 2 * d * r₁) + ((-(d * (r₁ + r₂))) + 2 * d * r₂) = 0 := by grind

/-! ## 2. Litim cutoff, λ = 0: unequal exponents -/

/-- In y = g/(12π) the flow is dy/dt = y(2 − 46y)/(1 − y). Partial fractions of 1/β, cross-multiplied:
(1 − y)/(y(2 − 46y)) = (1/2)/y + 22/(2 − 46y). -/
theorem litim_partial_fractions (y : Int) : (2 - 46 * y) + 2 * 22 * y = 2 * (1 - y) := by omega

/-- The exponents are 1/2 at the Gaussian point and 22/46 = 11/23 = 1/θ at the UV point,
so θ = 23/11 and the mismatch is 1/2 − 11/23 = 1/46. -/
theorem litim_mismatch : 1 * 46 - 2 * 11 * 1 = 2 * 12 ∧ 23 * 2 - 11 * 4 = 2 ∧ 23 - 22 = 1 := by decide

/-! ## 3. Large N: two decoupled circle-op flows -/

/-- u = 1/g: g²·du/dt = −β_g with β_g = (D−2)g − a g², so du/dt = −(D−2)u + a. -/
theorem largeN_u (g a D : Int) : -((D - 2) * g - a * g * g) = g * g * a - (D - 2) * g := by grind

/-- v = λ/g: g²·dv/dt = β_λ g − λ β_g with β_λ = −2λ − a g λ + b g, which equals g(b g − D λ),
so dv/dt = b − D v: rate D, the units of the vacuum energy Λ/G. -/
theorem largeN_v (g l a b D : Int) :
    ((-2) * l - a * g * l + b * g) * g - l * ((D - 2) * g - a * g * g) = g * (b * g - D * l) := by grind

/-! ## 4. Donà–Eichhorn–Percacci's perturbative flow -/

/-- β_G = 2G + A G², β_Λ = −2Λ + B G + C G Λ. Then G²·d(Λ/G)/dt = G(B G − 4Λ + (C − A) G Λ):
the circle-op form −4v + B plus one extra term (C − A)Λ. -/
theorem dep_v (G L A B C : Int) :
    ((-2) * L + B * G + C * G * L) * G - L * (2 * G + A * G * G) = G * (B * G - 4 * L + (C - A) * G * L) := by
  grind

/-- With A = X − 46 and C = X − 16 (in units of 1/6π), C − A = 30 for every matter content X. -/
theorem dep_extra (X : Int) : (X - 16) - (X - 46) = 30 := by omega

/-! ## 5. The Gaussian point is a pure boost -/

/-- J = [[2, 0], [c, −2]] squares to 4·I. -/
theorem gaussian_boost (c : Int) :
    2 * 2 + 0 * c = 4 ∧ 2 * 0 + 0 * (-2) = 0 ∧ c * 2 + (-2) * c = 0 ∧ c * 0 + (-2) * (-2) = 4 := by
  refine ⟨by omega, by omega, by grind, by omega⟩

end BeyondOneLoop
